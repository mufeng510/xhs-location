    <string name="settings_ip_title">关于 IP 地区说明</string>
    <string name="settings_ip_desc">本应用只能模拟 GPS / 网络定位的经纬度，无法修改手机的出口 IP 地址。小红书“我 – IP”显示的地区依赖网络 IP 归属地，单靠定位模拟无法改变。</string>
    <string name="settings_ip_steps">如需改变小红书显示的地区，建议：\n1. 连接一个目标地区的代理/VPN（使出口 IP 变为该地）；\n2. 在本应用中设置相同地区的经纬度与城市；\n3. 开启模拟定位，再打开小红书查看。</string>
    <string name="vpn_settings_title">VPN 代理设置</string>
    <string name="vpn_enable_proxy">启用代理 VPN</string>
    <string name="vpn_enable_desc">开启后，设备全部网络流量将经代理服务器转发，可修改小红书等 App 看到的出口 IP 地区。</string>
    <string name="vpn_proxy_config">代理服务器配置</string>
    <string name="vpn_proxy_server">代理服务器地址</string>
    <string name="vpn_proxy_server_placeholder">例如：123.45.67.89 或 proxy.example.com</string>
    <string name="vpn_proxy_port">端口</string>
    <string name="vpn_proxy_desc">可从上方“代理源”区域勾选免费代理池（GitHub 持续更新，实测小红书可达性），或手动填入代理。免费代理不稳定，建议使用付费住宅/宽带代理。</string>
    <string name="vpn_status_title">VPN 状态</string>
    <string name="vpn_status_enabled">代理已启用</string>
    <string name="vpn_status_disabled">代理未启用</string>
    <string name="vpn_status_desc">首次启用时系统会弹出 VPN 连接允许对话框，请点击“允许”。</string>
    <string name="vpn_btn_start">启动 VPN</string>
    <string name="vpn_btn_stop">停止 VPN</string>
    <string name="btn_save">保存</string>
    <string name="vpn_permission_tip">VPN 需要系统权限才能拦截全局流量，仅用于本地代理转发，不上传任何数据。</string>
    <string name="btn_settings">VPN 代理设置</string>
    <string name="vpn_auto_fetch_title">自动获取最新代理</string>
    <string name="vpn_auto_fetch_desc">进入页面自动从下方所选代理源获取最新中国代理（合并、去重），实测小红书可达性与真实 IP 归属地；小红书可达的节点已置顶。免费代理不稳定，可点“一键获取代理”刷新。</string>
    <string name="vpn_sources_title">代理源（多选合并）</string>
    <string name="vpn_sources_select_all">全选</string>
    <string name="vpn_sources_reset">恢复默认</string>
    <string name="vpn_sources_hint">所选源并发拉取 → 合并后按 ip:port 去重 → 截断 60 个实测。失败的源单独标出，不自动改用其他源；取消勾选的源不参与获取。</string>
